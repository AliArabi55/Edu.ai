# Edu.ai Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_REGION=your-azure-region

# Azure VoiceLive Configuration (same as OpenAI for most setups)
AZURE_VOICELIVE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_VOICELIVE_API_KEY=your-azure-openai-key-here
AZURE_VOICELIVE_REGION=your-azure-region

# Instructions for Sam Avatar (optional - will use default if not set)
VOICELIVE_INSTRUCTIONS=Act as 'Sam,' a friendly English teacher who explains AI to children...

# How to get your Azure keys:
# 1. Go to https://portal.azure.com
# 2. Create an Azure OpenAI resource
# 3. Go to "Keys and Endpoint" section
# 4. Copy the endpoint URL and one of the keys
# 5. Replace the values above with your actual values
# 6. Save this file as .env (without .example)